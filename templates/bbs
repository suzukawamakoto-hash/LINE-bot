<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>交流掲示板</title>
  <style>
    body { font-family: sans-serif; max-width: 700px; margin: 0 auto; padding: 20px; }
    .msg { color: green; } .err { color: red; }
    hr { border: none; border-top: 1px solid #ddd; margin: 15px 0; }
  </style>
</head>
<body>
  <h1>📢 交流掲示板</h1>

  {% if current_user.is_authenticated %}
    <p>{{ current_user.username }} さん
    ｜<a href="{{ url_for('create_post') }}">✏️ 投稿する</a>
    ｜<a href="{{ url_for('logout') }}">ログアウト</a></p>
  {% else %}
    <p><a href="{{ url_for('login') }}">ログイン</a>
    ｜<a href="{{ url_for('register') }}">新規登録</a></p>
  {% endif %}

  {% with msgs = get_flashed_messages() %}
    {% for m in msgs %}<p class="msg">{{ m }}</p>{% endfor %}
  {% endwith %}

  <hr>

  {% for post in posts %}
    <h3>{{ post.title }} — {{ post.author.username }}</h3>
    <p style="white-space: pre-wrap;">{{ post.content }}</p>
    <small>{{ post.created_at.strftime('%Y-%m-%d %H:%M') }}</small>
    <hr>
  {% else %}
    <p>まだ投稿がありません。最初の投稿をしてみよう！</p>
  {% endfor %}
</body>
</html>
